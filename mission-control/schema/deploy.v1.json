{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.dev/schema/deploy.v1.json",
  "title": "Deploy files: deploy/components/<name>.yaml, deploy/hosts.yaml, deploy/deployments.yaml",
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
    "eventType": {"type": "string", "pattern": "^dev\\.factory\\.[a-z0-9_.]+$"},
    "env": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string"},
        "image": {"type": "string", "minLength": 1},
        "build": {
          "type": "object", "additionalProperties": false, "required": ["dockerfile"],
          "properties": {"dockerfile": {"type": "string"}, "context": {"type": "string"}}
        },
        "command": {"type": "array", "items": {"type": "string"}},
        "llm": {"enum": ["none", "project", "api_key"]},
        "run_as": {"type": "string", "pattern": "^[0-9]+(:[0-9]+)?$"},
        "tmpfs": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": {"cpus": {"type": "string"}, "memory": {"type": "string"}}
        },
        "env": {"$ref": "#/$defs/env"},
        "per_product": {"type": "boolean"},
        "consumes": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["type"],
                    "properties": {"type": {"$ref": "#/$defs/eventType"}}}
        },
        "emits": {"type": "array", "items": {"$ref": "#/$defs/eventType"}}
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "kind"],
            "properties": {
              "id": {"$ref": "#/$defs/name"},
              "kind": {"enum": ["local", "vm"]},
              "address": {"type": "string"},
              "machine_type": {"type": "string"},
              "zone": {"type": "string"},
              "labels": {"type": "object", "additionalProperties": {"type": "string"}}
            }
          }
        }
      }
    },
    "deployments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployments"],
      "properties": {
        "deployments": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["component", "host"],
            "properties": {
              "component": {"$ref": "#/$defs/name"},
              "host": {"$ref": "#/$defs/name"},
              "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
              "replicas": {"type": "integer", "minimum": 0, "maximum": 20},
              "products": {"type": "array", "items": {"type": "string"}},
              "env": {"$ref": "#/$defs/env"}
            }
          }
        }
      }
    }
  }
}
